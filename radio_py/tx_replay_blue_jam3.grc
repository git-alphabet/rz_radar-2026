options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: Replay recorded Blue level-3 jamming IQ.
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: tx_replay_blue_jam3
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Blue level-3 jamming replay transmitter
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: pluto_uri
  id: variable
  parameters:
    comment: AntSDR/Pluto-compatible IIO URI
    value: '"ip:192.168.1.10"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 456.0]
    rotation: 0
    state: enabled
- name: recording_path
  id: variable
  parameters:
    comment: Complex64 IQ recording centered on Blue level-3 jamming wave
    value: '"C:/Users/GMD777/Desktop/radio_py/RX_BLUE_ganrao_3"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 8.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Recording sample rate. Offline validation shows this file is 2 MS/s IQ.
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 8.0]
    rotation: 0
    state: enabled
- name: tx_attenuation
  id: variable
  parameters:
    comment: Pluto/FMComms2 TX attenuation in dB. Lower means stronger output.
    value: '10.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 248.0]
    rotation: 0
    state: enabled
- name: tx_center_freq
  id: variable
  parameters:
    comment: Blue level-3 jamming frequency from the rulebook
    value: 434.320e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 8.0]
    rotation: 0
    state: enabled
- name: tx_rf_bandwidth
  id: variable
  parameters:
    comment: Wider hardware filter for replay; baseband channel filter still selects jam3.
    value: 1.0e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 152.0]
    rotation: 0
    state: enabled
- name: tx_scale
  id: variable
  parameters:
    comment: Additional complex IQ scale. Recording peak is about 0.35, so 1.0 does
      not clip.
    value: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 352.0]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: Repeats the captured Blue level-3 jamming IQ file continuously.
    file: recording_path
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'True'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 224.0]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: tx_scale
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 256.0]
    rotation: 0
    state: enabled
- name: iio_fmcomms2_sink_0
  id: iio_fmcomms2_sink
  parameters:
    affinity: ''
    alias: ''
    attenuation1: tx_attenuation
    attenuation2: tx_attenuation
    bandwidth: int(tx_rf_bandwidth)
    buffer_size: '32768'
    comment: ''
    cyclic: 'False'
    filter: ''
    filter_source: '''Design'''
    fpass: 0.45e6
    frequency: int(tx_center_freq)
    fstop: 0.60e6
    len_tag_key: '""'
    rf_port_select: '''A'''
    samplerate: int(samp_rate)
    tx1_en: 'True'
    tx2_en: 'False'
    type: fc32
    uri: pluto_uri
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 164.0]
    rotation: 0
    state: enabled

connections:
- [blocks_file_source_0, '0', blocks_multiply_const_vxx_0, '0']
- [blocks_multiply_const_vxx_0, '0', iio_fmcomms2_sink_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
