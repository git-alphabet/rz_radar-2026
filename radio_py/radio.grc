- name: freq_xlating_fir_filter_info
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: info_offset
    comment: Translate this RF wave to 0 Hz and decimate 4 MS/s to 1 MS/s before GFSK
      demod.
    decim: xlate_decim
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
