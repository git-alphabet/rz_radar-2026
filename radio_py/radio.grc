- name: epy_block_info
  id: epy_block
  parameters:
    _source_code: "import os\nimport sys\n\n_module_file = globals().get(\n    \"\
      __file__\",\n    r\"/home/alphabet/rz_radar-2026/radio_py/gr_air_frame_extractor.py\"\
      ,\n)\n_module_dir = os.path.dirname(os.path.abspath(_module_file))\nif _module_dir\
      \ not in sys.path:\n    sys.path.insert(0, _module_dir)\n\nfrom gr_air_frame_extractor\
      \ import AccessCodeBitFrameExtractor\n"
    access_code_hex: '"2F6F4C74B914492E"'
    affinity: ''
    alias: ''
    bit_order: '"msb"'
    comment: ''
    frame_bytes: '27'
    header_hex: '"000F000F"'
    maxoutbuf: '0'
    minoutbuf: '0'
    output_mode: '"bits"'
  states:
    _io_cache: ('Access Code Bit Frame Extractor', 'AccessCodeBitFrameExtractor',
      [('access_code_hex', "'2F6F4C74B914492E'"), ('header_hex', "'000F000F'"), ('frame_bytes',
      '27'), ('bit_order', "'msb'"), ('output_mode', "'bits'")], [('0', 'byte', 1)],
      [('0', 'byte', 1)], '', ['bit_order', 'frame_bytes', 'output_mode'])
    bus_sink: false
    bus_source: false
