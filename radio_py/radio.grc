options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: radio
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Blue radar four-wave receiver
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: channel_samp_rate
  id: variable
  parameters:
    comment: Per-wave sample rate after Frequency Xlating FIR decimation
    value: samp_rate / xlate_decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 296.0]
    rotation: 0
    state: enabled
- name: channel_transition
  id: variable
  parameters:
    comment: Digital channel filter transition width
    value: 20e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 48.0]
    rotation: 0
    state: enabled
- name: info_cutoff
  id: variable
  parameters:
    comment: Blue info bandwidth 0.54 MHz / 2
    value: 0.27e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1448, 40.0]
    rotation: 0
    state: enabled
- name: info_freq
  id: variable
  parameters:
    comment: Blue broadcast/info-wave center from table
    value: 433.920e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 176.0]
    rotation: 0
    state: enabled
- name: info_offset
  id: variable
  parameters:
    comment: Frequency Xlating FIR offset for blue info wave
    value: info_freq - rx_center_freq
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1168, 344.0]
    rotation: 0
    state: enabled
- name: info_sensitivity
