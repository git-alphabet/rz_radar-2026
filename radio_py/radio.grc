options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: radio
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: pluto_uri
  id: variable
  parameters:
    comment: ip address
    value: '"ip:192.168.1.10"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1792, 252.0]
    rotation: 0
    state: enabled
- name: red_sensitivity
  id: variable
  parameters:
    comment: ''
    value: '1.5756'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1640, 36.0]
    rotation: 0
    state: enabled
- name: rx_center_freq
  id: variable
  parameters:
    comment: 'Red info source: 433.2e6; blue info source: 433.92e6'
    value: 433.2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1792, 36.0]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters:
    comment: Pluto RX manual gain, tune on field
    value: '60'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2184, 380.0]
    rotation: 0
    state: enabled
- name: rx_rf_bandwidth
  id: variable
  parameters:
    comment: 0.6e6 to 0.8e6 for 0.54 MHz info wave
    value: 0.7e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2184, 44.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
