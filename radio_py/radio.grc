- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: 'import sys

      sys.path.insert(0, "/home/robomaster/Downloads/radar_radio_FixedWithGRC&Code")

      from gr_air_frame_extractor import AccessCodeBitFrameExtractor

      '
    affinity: ''
    alias: ''
    comment: Emits aligned 27-byte air frames after Access Code tagging.
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Access Code Bit Frame Extractor', 'AccessCodeBitFrameExtractor',
      [], [('0', 'byte', 1)], [('0', 'byte', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1312, 720.0]
    rotation: 0
    state: enabled
